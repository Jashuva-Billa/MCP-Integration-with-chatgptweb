# Example local configuration. Copy these values into your private .env as needed.
MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_DEPLOYMENT_MODE=local
# Permission profile: safe | full | trusted_admin | unrestricted (local trusted use only)
MCP_PERMISSION_PROFILE=full
MCP_AUTH_ENABLED=false
MCP_AUTH_TOKEN=

# For cloud deployments, set exact provider hostname(s), no scheme/path/wildcards.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Remote repository cloning is off until explicitly enabled and allowlisted.
MCP_GITHUB_CLONE_ENABLED=false
MCP_GITHUB_ALLOWED_REPOS=
MCP_GITHUB_TOKEN=
MCP_WORKSPACE_ROOT=/tmp/mcp-workspaces

# Remote Git delivery stays disabled unless explicitly enabled in a trusted deployment.
MCP_GIT_PUSH_ENABLED=false
MCP_GIT_PUSH_REQUIRE_APPROVAL=true

# Optional real CLI worker runtimes. Install/authenticate each CLI before enabling it.
# Example JSON: {"codex":["codex","exec","--full-auto","{prompt}"],"claude":["claude","-p","{prompt}"],"cursor":["agent","-p","{prompt}"]}
MCP_WORKER_COMMANDS=
MCP_WORKER_MAX_CONCURRENCY=3
MCP_WORKER_TIMEOUT_SECONDS=1800
MCP_WORKER_SANDBOX_MODE=docker
MCP_WORKER_SANDBOX_IMAGE=mcp-coding-worker:latest
MCP_WORKER_NETWORK_MODE=none
# Optional narrow read-only CLI credential mounts as a JSON array; never mount the whole home directory.
MCP_WORKER_CREDENTIAL_MOUNTS=
# Host mode is not sandboxed and requires explicit opt-in.
MCP_WORKER_HOST_MODE_ALLOWED=false
MCP_WORKER_SYNTHESIS_ENABLED=false

# Independent verification runs in fresh processes. Default: pytest + Ruff.
# Override with a JSON array of argv arrays; never use shell command strings.
MCP_VERIFICATION_COMMANDS=
MCP_VERIFICATION_TIMEOUT_SECONDS=600
MCP_DASHBOARD_ENABLED=true
