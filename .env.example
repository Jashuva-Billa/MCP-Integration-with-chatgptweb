# Standalone Multi-Repository MCP Server Configuration

MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_LOG_LEVEL=INFO

# Authentication Configuration (Set to true to require Bearer token header)
MCP_AUTH_ENABLED=false
MCP_AUTH_TOKEN=change-me-to-a-secure-token

# Optional custom path to cloudflared executable (leave blank if in system PATH)
CLOUDFLARED_PATH=

# Permanent Static Tunnel Options (Choose ONE so your ChatGPT plugin NEVER changes):
# -----------------------------------------------------------------------------------
# Option 1: Free Ngrok Static Domain (Recommended if you don't own a domain)
# Claim your 1 free static domain at https://dashboard.ngrok.com/endpoints
# NGROK_DOMAIN=your-permanent-name.ngrok-free.app

# Option 2: Cloudflare Zero Trust Named Tunnel (If you have a domain on Cloudflare)
# CLOUDFLARE_TUNNEL_TOKEN=
# STATIC_TUNNEL_URL=https://mcp.yourdomain.com

# Operational Safety Limits
MAX_FILE_SIZE_BYTES=2097152
MAX_COMMAND_OUTPUT_BYTES=102400
COMMAND_TIMEOUT_SECONDS=120
MAX_SEARCH_RESULTS=100
